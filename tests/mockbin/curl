#!/bin/bash
# curl giả lập cho test offline (xem tests/run_tests.sh)
# - HTML của TruyenVN: trả fixture theo đường dẫn trong URL
# - API POST /webapi/stories/list-chapter: trả JSON fixture (giả lập được 419/500)
# - Ảnh (imggo.net / /uploads/): ghi vài byte giả, không có -w
# - Host chứa "manga-offline": mô phỏng mất mạng (HTTP 000, không body)
url=""; out=""; data=""; post=""; wmode=""; referer=""; ua=""; has_cookie=0; headmode=0
args=("$@")
skip_next=0
for i in "${!args[@]}"; do
    a="${args[$i]}"
    nxt="${args[$((i + 1))]}"
    if [ "$skip_next" = "1" ]; then
        skip_next=0
        continue          # bỏ qua giá trị của tham số (không nhầm thành URL)
    fi
    case "$a" in
        -o|--output) out="$nxt"; skip_next=1 ;;
        -w|--write-out) wmode="1"; skip_next=1 ;;
        -e|--referer) referer="$nxt"; skip_next=1 ;;
        -A|--user-agent) ua="$nxt"; skip_next=1 ;;
        -H|--header|-X|--request) skip_next=1 ;;
        -I|--head) headmode=1 ;;
        --max-time|--retry|--retry-delay|--connect-timeout|--resolve|--proxy|-x) skip_next=1 ;;
        -c|--cookie-jar|-b|--cookie) has_cookie=1; skip_next=1 ;;
        --data|--data-raw|--data-binary) post="$nxt"; skip_next=1 ;;
        --data-urlencode) enc=${nxt// /%20}; data="$data&$enc"; skip_next=1 ;;
        http://*|https://*)
            case "$a" in
                *"/truyen-tranh/"*|*"/tim-kiem"*|*"/the-loai/"*|*"/webapi/"*|*"/chapter-"*|*"/danh-sach"*|*"/v1/api/"*|*"/phim/"*|*imggo.net*|*imgchapter*|*nettruyen.info*|*e-hentai.org*|*kagane.moe*|*cloudflare-dns.com*|*dns.google*|*codeload.github.com*|*"/uploads/"*|*"manga-offline"*|*dnsblock*)
                    url="$a" ;;   # URL thật luôn là tham số cuối -> lấy cái cuối cùng
            esac ;;
    esac
done
eff="$url$data$post"
[ -n "${MOCK_CURL_LOG:-}" ] && printf '%s\n' "$eff" >> "$MOCK_CURL_LOG"
# log header để kiểm tra Referer (CDN ảnh của TruyenVN trả 403 nếu có Referer)
if [ -n "${MOCK_CURL_HEADER_LOG:-}" ]; then
    printf '%s|referer=%s|args=%s\n' "$url" "${referer:-none}" "${args[*]}" >> "$MOCK_CURL_HEADER_LOG"
fi

code="200"
body=""
case "$eff" in
    *codeload.github.com*)
        # archive cập nhật (tar.gz) - có MOCK_UPDATE_TARBALL thì trả file thật
        if [ -n "${MOCK_UPDATE_TARBALL:-}" ] && [ -f "$MOCK_UPDATE_TARBALL" ]; then
            body="$MOCK_UPDATE_TARBALL"
        else
            code="000"; body=""
        fi ;;
    *manga-offline*)        code="000"; body="" ;;
    *kagane.moe/api/integrity*)
        # token đọc ngắn hạn; MOCK_KG_INTEGRITY_FAIL=1 -> bị chặn
        if [ "${MOCK_KG_INTEGRITY_FAIL:-0}" = "1" ]; then
            code="403"; body="${MOCK_FIXTURES}/kagane-error.json"
        else
            body="${TMPDIR:-/tmp}/mock-kg-integrity-$$.json"
            printf '{"token":"mock-integrity-token","exp":%s}' "$(( $(date +%s) + 3600 ))" > "$body"
            code="200"
        fi ;;
    *kagane.moe/api/v2/books/page/*)
        body="" ;;                      # ảnh: nhánh "tải ảnh" bên dưới ghi file giả
    *kagane.moe/api/v2/books/*intent=Read*)
        if [ "${MOCK_KG_CHALLENGE_FAIL:-0}" = "1" ]; then
            code="403"; body="${MOCK_FIXTURES}/kagane-error.json"
        elif [ -n "${MOCK_KG_CHALLENGE_401:-}" ]; then
            # lần đầu 401 (token cũ hết hạn), lần sau OK -> test tự xin token mới
            if [ -f "${MOCK_KG_CHALLENGE_401}" ]; then
                body="${MOCK_FIXTURES}/kagane-challenge.json"
            else
                : > "${MOCK_KG_CHALLENGE_401}"
                code="401"; body="${MOCK_FIXTURES}/kagane-error.json"
            fi
        else
            body="${MOCK_FIXTURES}/kagane-challenge.json"
        fi ;;
    *kagane.moe/api/v2/series/*/books/index*)
        body="${MOCK_FIXTURES}/kagane-books.json" ;;
    *kagane.moe/api/v2/series/*)
        body="${MOCK_FIXTURES}/kagane-series.json" ;;
    *kagane.moe/search*|*kagane.moe/*)
        body="${MOCK_FIXTURES}/kagane-search.html" ;;
    *cloudflare-dns.com*|*dns.google*)
        # DNS-over-HTTPS giả lập: trả JSON có 1 bản ghi A
        body="${MOCK_DOH_JSON:-$(mktemp 2>/dev/null)}"
        printf '{"Status":0,"Answer":[{"name":"x","type":1,"TTL":300,"data":"%s"}]}' "${MOCK_DOH_IP:-203.0.113.10}" > "$body" 2>/dev/null
        code="200" ;;
    *dnsblock*)
        # Giả lập nhà mạng chặn DNS: 000 + curl mã 6, TRỪ KHI đã có --resolve (đi DoH)
        case " $* " in
            *" --resolve "*)
                code="200"
                body="${MOCK_FIXTURES:-/nonexistent}/ehentai-tag.html" ;;
            *)  code="000"; body="" ;;
        esac ;;
    *"/webapi/stories/list-chapter"*)
        if [ -n "${MOCK_API_419:-}" ] && [ ! -f "${MOCK_API_419}" ]; then
            : > "${MOCK_API_419}"          # lần đầu: phiên hết hạn
            code="419"; body="${MOCK_FIXTURES}/manga-api-419.json"
        elif [ "${MOCK_API_FAIL:-0}" = "1" ]; then
            code="500"; body="${MOCK_FIXTURES}/manga-api-500.json"
        elif [ -z "$post" ] && [ -z "$data" ]; then
            code="400"; body="${MOCK_FIXTURES}/manga-api-500.json"
        else
            body="${MOCK_FIXTURES}/manga-chapters-api.json"
        fi ;;
    *r.jina.ai*)             body="${MOCK_FIXTURES}/manga-chapter-jina.md" ;;
    *nettruyen.info/tim-kiem*)       body="${MOCK_FIXTURES}/nt-search.html" ;;
    *nettruyen.info/the-loai/*)      body="${MOCK_FIXTURES}/nt-search.html" ;;
    *nettruyen.info/truyen-tranh-hot*) body="${MOCK_FIXTURES}/nt-search.html" ;;
    *e-hentai.org/s/*)              body="${MOCK_FIXTURES}/ehentai-img.html"
                                    # mỗi trang ảnh trả 1 link khác nhau (theo số trang)
                                    eh_idx=$(printf '%s' "$url" | sed -n 's#.*/s/[0-9A-Za-z]*/[0-9]*-\([0-9]*\).*#\1#p')
                                    if [ -n "$eh_idx" ]; then
                                        eh_tmp="${TMPDIR:-/tmp}/mock-eh-img-$$-$eh_idx.html"
                                        sed "s/4304955-7\.jpg/4304955-$eh_idx.jpg/" "$body" > "$eh_tmp" 2>/dev/null && body="$eh_tmp"
                                    fi ;;
    *e-hentai.org/g/9999999/*)      body="${MOCK_FIXTURES}/ehentai-single.html" ;;
    *e-hentai.org/g/*)              body="${MOCK_FIXTURES}/ehentai-gallery.html" ;;
    *e-hentai.org/tag/*)            body="${MOCK_FIXTURES}/ehentai-tag.html" ;;
    *f_search=*)                    body="${MOCK_FIXTURES}/ehentai-tag.html" ;;
    *e-hentai.org*)                 body="${MOCK_FIXTURES}/ehentai-tag.html" ;;
    *nettruyen.info/*chuong-*)       body="${MOCK_FIXTURES}/nt-chapter.html" ;;
    *nettruyen.info/truyen-*)        body="${MOCK_FIXTURES}/nt-story.html" ;;
    *nettruyen.info*)                body="${MOCK_FIXTURES}/nt-search.html" ;;
    *cloudflare*)            body="${MOCK_FIXTURES}/manga-challenge.html" ;;
    *modern*)                body="${MOCK_FIXTURES}/manga-chapter-modern.html" ;;
    *"/chapter-"*js*)       body="${MOCK_FIXTURES}/manga-chapter-js.html" ;;
    *"no-story-id"*)        body="${MOCK_FIXTURES}/manga-detail-no-story-id.html" ;;
    *"/chapter-"*)
        if [ "${MOCK_STRIP_CHAPTER:-0}" = "1" ]; then
            # giả lập: trang chapter trả bản rút gọn trừ khi request đúng kiểu
            case "${MOCK_STRIP_UNLESS:-bot}" in
                bot)     case "$ua" in *Googlebot*) body="${MOCK_FIXTURES}/manga-chapter-modern.html" ;; *) body="${MOCK_FIXTURES}/manga-challenge.html" ;; esac ;;
                minimal) if [ "$has_cookie" = "1" ]; then body="${MOCK_FIXTURES}/manga-challenge.html"; else body="${MOCK_FIXTURES}/manga-chapter-modern.html"; fi ;;
                *)       body="${MOCK_FIXTURES}/manga-challenge.html" ;;
            esac
        else
            body="${MOCK_FIXTURES}/manga-chapter.html"
        fi ;;
    *"/chapter-"*)           body="${MOCK_FIXTURES}/manga-chapter.html" ;;
    *"/truyen-tranh/"*)      body="${MOCK_FIXTURES}/manga-detail.html" ;;
    *"/tim-kiem"*|*"/the-loai/"*|*"/danh-sach"*) body="${MOCK_FIXTURES}/manga-home.html" ;;
    *imggo.net*|*imgchapter*|*"/uploads/"*) body="" ;;   # ảnh: chỉ ghi file giả
    "")                     code="404" ;;
    *)                      body="${MOCK_FIXTURES}/manga-home.html" ;;
esac

# HEAD (chỉ lấy status): trang ảnh trả 200 (giả lập 3 trang đầu), còn lại 404
if [ "$headmode" = "1" ]; then
    case "$url" in
        *imgchapter*)
            idx=$(printf '%s' "$url" | sed -n 's/.*page_\([0-9]*\)\..*/\1/p')
            if [ -n "${MOCK_IMG_MAX_PAGE:-}" ] && [ -n "$idx" ] && [ "$idx" -ge "$MOCK_IMG_MAX_PAGE" ]; then
                printf '%s' 404
            else
                printf '%s' 200
            fi ;;
        *imggo.net*|*"/uploads/"*) printf '%s' 200 ;;
        *) printf '%s' 404 ;;
    esac
    exit 0
fi

# Tải archive cập nhật (không có -w): chép đúng file tar.gz, không ghi ảnh giả
if [ -z "$wmode" ] && [ -n "$out" ]; then
    case "$url" in
        *codeload.github.com*)
            if [ -n "${MOCK_UPDATE_TARBALL:-}" ] && [ -f "$MOCK_UPDATE_TARBALL" ]; then
                cp "$MOCK_UPDATE_TARBALL" "$out"
                exit 0
            fi
            exit 22 ;;
    esac
fi

# DNS-over-HTTPS (không có -o/-w): in JSON ra stdout
if [ -z "$wmode" ] && [ -z "$out" ]; then
    case "$url" in
        *cloudflare-dns.com*|*dns.google*)
            cat "$body" 2>/dev/null
            exit 0 ;;
    esac
fi

# Tải ảnh (không có -w): ghi file giả rồi thoát
if [ -z "$wmode" ]; then
    if [ -n "$out" ]; then
        if [ "${MOCK_IMG_NEED_REFERER:-0}" = "1" ] && [ -z "$referer" ]; then
            printf '<html><body>403 Forbidden (cần Referer)</body></html>' > "$out"
        elif [ "${MOCK_IMG_FORBIDDEN:-0}" = "1" ]; then
            printf '<html><body>403 Forbidden</body></html>' > "$out"   # CDN chặn
        else
            printf '\xff\xd8\xff\xe0fake-jpg-bytes' > "$out"
        fi
    fi
    exit 0
fi

if [ -n "$out" ]; then
    if [ "$code" = "200" ] && [ -n "$body" ]; then
        cp "$body" "$out" 2>/dev/null || : > "$out"
    else
        if [ -n "$body" ] && [ -s "$body" ]; then
            cp "$body" "$out" 2>/dev/null || printf '{"message":"error"}' > "$out"
        else
            printf '<html>%s Bad Gateway</html>' "$code" > "$out"
        fi
    fi
else
    [ "$code" = "200" ] && [ -n "$body" ] && cat "$body"
fi
printf '%s' "$code"
# Giả lập mã thoát của curl khi không kết nối được (000) để test phần gợi ý lỗi
[ "$code" = "000" ] && exit "${MOCK_CURL_EXIT:-6}"
exit 0
